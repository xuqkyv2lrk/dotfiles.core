#!/usr/bin/env bash
# Picks a working pinentry for whatever machine this file lands on.
# gpg-agent.conf points at this file (not a specific pinentry binary) because
# it's the same gpg-agent.conf on every machine (dotfiles.core is shared
# between macOS and Linux boxes) but the right binary — and its absolute
# path — differs per OS and per package manager:
#   macOS (Homebrew):    /opt/homebrew/bin/pinentry-mac   (native GUI + Touch ID)
#   Linux (GUI session):  pinentry-gnome3 / pinentry-qt
#   Linux (TTY/SSH) or fallback: pinentry-curses, then plain pinentry
#
# gpg-agent invokes this by absolute path with no shell/PATH setup of its
# own, so resolve everything here rather than relying on `pinentry-program`
# PATH lookup (GnuPG requires pinentry-program to be a real path, not a bare
# command name).
for candidate in pinentry-mac pinentry-gnome3 pinentry-qt pinentry-curses pinentry; do
    if path="$(command -v "${candidate}" 2>/dev/null)"; then
        exec "${path}" "$@"
    fi
done

echo "ERR 67108949 No usable pinentry found on this machine <pinentry-dispatch>" >&2
exit 1
